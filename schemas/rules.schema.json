{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinit010/AI-Context-OS/schemas/rules.schema.json",
  "title": "Engineering rulebook",
  "description": "Front matter of `.ai/RULES.md`. A rule without a stated reason is a preference, so `justification` exists to be required rather than optional: CONTEXT_SPEC 6 makes every rule carry the reason it exists.",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^RULES-[0-9]+$" },
    "type": { "const": "rules" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "draft", "accepted", "deprecated", "superseded"] },
    "applies_to": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Path globs or crate names the rules bind. Empty means the whole repository."
    },
    "created": { "$ref": "#/$defs/iso-date" },
    "updated": { "$ref": "#/$defs/iso-date" },
    "tags": { "$ref": "#/$defs/tags" }
  },
  "$defs": {
    "iso-date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}