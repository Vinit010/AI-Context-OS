{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinit010/AI-Context-OS/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "One documented recurring procedure, as `.ai/workflows/<slug>.md`. Named, not numbered: a workflow is invoked by name, so its ID and its filename must be the same word.",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": { "type": "string", "pattern": "^WF-[a-z0-9]+(-[a-z0-9]+)*$" },
    "type": { "const": "workflow" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "draft", "deprecated"] },
    "trigger": {
      "type": "string",
      "minLength": 1,
      "description": "What makes this run: a branch name, a file change, a command, or a person."
    },
    "steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "The procedure, in order. A workflow with no steps is a name for nothing."
    },
    "created": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}